# 部署环境变量示例：复制为 .env 后按需修改
# cp .env.example .env

# ---- 后端 ----
APP_PORT=8000
FASTAPI_ENV=docker
DEBUG=false
SECRET_KEY=change-me-in-docker-min-32-chars-please
CORS_ORIGINS=*

# ---- MySQL ----
MYSQL_PORT=3306
MYSQL_DATABASE=content_hub
MYSQL_USER=ach
MYSQL_PASSWORD=ach_password
MYSQL_ROOT_PASSWORD=root_password

# ---- Redis ----
REDIS_PUBLISH_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
CACHE_ENABLED=true

# ---- 前端（可选，--profile web）----
WEB_PORT=3000
