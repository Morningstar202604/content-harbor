# Docker Compose 可选覆盖（项目根目录）
# 用法：docker compose -f deploy/docker-compose.yml --env-file backed/.env.docker up --build
#
# 安全提示：部署前必须修改以下密码！
# 生成强密码: python -c "import secrets; print(secrets.token_urlsafe(24))"

FASTAPI_ENV=docker
DEBUG=false
# SECRET_KEY 必须修改（至少 32 字符）
SECRET_KEY=
APP_PORT=8000

# MySQL 密码必须设置（禁止空密码/弱密码）
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=content_hub
MYSQL_USER=ach
MYSQL_PASSWORD=
MYSQL_PORT=3306

# Redis（生产环境必须设置密码）
REDIS_HOST=
REDIS_PUBLISH_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
